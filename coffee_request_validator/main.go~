package main

import (
	"fmt"
	"os"
	"strconv"
)

func main() {
	var frameLength int
	fmt.Scan(&frameLength)

	var frame string
	fmt.Scan(&frame)

	fmt.Fprintln(os.Stderr, "franeLength:", frameLength)
	fmt.Fprintln(os.Stderr, "frame:", frame)

	var orderSize int
	var header string
	//var frameSize string
	var orderData string
	var checksum string
	orders := make(map[string]int)

	orderSize = frameLength - 12
	fmt.Fprintln(os.Stderr, "orderSize:", orderSize)
	
	if frameLength < 8 {	
		fmt.Println("403 Forbidden")
		return 
	}	

	header = frame[:8]
	fmt.Fprintln(os.Stderr, "header:", header)

	//frameSize = orderSize

	orderData = frame[11 : frameLength-1]
	fmt.Fprintln(os.Stderr, "orderData:", orderData)

	checksum = frame[frameLength-1:]
	fmt.Fprintln(os.Stderr, "checksum:", checksum)

	var tot int64
	for _, val := range frame {
		hex, _ := strconv.ParseInt(string(val), 16, 64)
		tot += hex
	}
	fmt.Fprintln(os.Stderr, "tot:", tot)
	if tot%16 != 0 {
		fmt.Println("403 Forbidden")
	} else {

		var ord []string

		for i := 0; i < orderSize; i++ {
			fmt.Fprintln(os.Stderr, "orderData[i]:", string(rune(orderData[i])))
			if orders[string(rune(orderData[i]))] == 0 {
				orders[string(rune(orderData[i]))] = 1
				ord = append(ord, string(rune(orderData[i])))
			} else {
				orders[string(rune(orderData[i]))]++
			}
		}

		for _, i := range ord {
			fmt.Println(orders[i], i)
		}
	}
}
